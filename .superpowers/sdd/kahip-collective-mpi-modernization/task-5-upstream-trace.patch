diff --git a/parallel/parallel_src/lib/communication/task5_oracle_trace.h b/parallel/parallel_src/lib/communication/task5_oracle_trace.h
new file mode 100644
index 0000000..e342182
--- /dev/null
+++ b/parallel/parallel_src/lib/communication/task5_oracle_trace.h
@@ -0,0 +1,173 @@
+#ifndef KAHIP_TASK5_ORACLE_TRACE_H
+#define KAHIP_TASK5_ORACLE_TRACE_H
+
+#include <mpi.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace kahip_task5_oracle_trace {
+enum stage {
+  graph_distribution_node_stage,
+  graph_distribution_edge_stage,
+  contraction_label_stage,
+  quotient_node_weight_stage,
+  quotient_edge_stage,
+  projection_request_stage,
+  projection_reply_stage,
+  ghost_update_stage,
+  block_propagation_stage,
+  final_partition_stage
+};
+
+struct record {
+  stage stage_id;
+  unsigned long long global_id;
+  std::string semantic_key;
+  std::string payload;
+};
+
+inline const char* stage_name(stage value) {
+  static const char* names[] = {
+      "graph-distribution-node", "graph-distribution-edge",
+      "contraction-label", "quotient-node-weight", "quotient-edge",
+      "projection-request", "projection-reply", "ghost-update",
+      "block-propagation", "final-partition"};
+  return names[static_cast<int>(value)];
+}
+
+inline record graph_distribution_node(unsigned long long id, int owner,
+                                      unsigned long long weight) {
+  return {graph_distribution_node_stage, id,
+          "owner:" + std::to_string(owner),
+          "weight=" + std::to_string(weight)};
+}
+
+inline record graph_distribution_edge(unsigned long long source,
+                                      unsigned long long target,
+                                      unsigned long long weight) {
+  return {graph_distribution_edge_stage, source,
+          "target:" + std::to_string(target),
+          "weight=" + std::to_string(weight)};
+}
+
+inline record contraction_label(unsigned long long id,
+                                unsigned long long label,
+                                unsigned long long coarse) {
+  return {contraction_label_stage, id,
+          "label:" + std::to_string(label),
+          "coarse=" + std::to_string(coarse)};
+}
+
+inline record quotient_node_weight(unsigned long long id,
+                                   unsigned long long weight) {
+  return {quotient_node_weight_stage, id, "node",
+          "weight=" + std::to_string(weight)};
+}
+
+inline record quotient_edge(unsigned long long source,
+                            unsigned long long target,
+                            unsigned long long weight) {
+  return {quotient_edge_stage, source,
+          "target:" + std::to_string(target),
+          "weight=" + std::to_string(weight)};
+}
+
+inline record projection_request(unsigned long long request_id, int source,
+                                 int destination,
+                                 unsigned long long coarse) {
+  return {projection_request_stage, coarse,
+          "request:" + std::to_string(request_id),
+          "source=" + std::to_string(source) +
+              " destination=" + std::to_string(destination)};
+}
+
+inline record projection_reply(unsigned long long request_id, int source,
+                               int destination, unsigned long long coarse,
+                               unsigned long long label) {
+  return {projection_reply_stage, coarse,
+          "request:" + std::to_string(request_id),
+          "source=" + std::to_string(source) +
+              " destination=" + std::to_string(destination) +
+              " label=" + std::to_string(label)};
+}
+
+inline record ghost_update(unsigned long long id, int owner,
+                           unsigned long long label) {
+  return {ghost_update_stage, id, "owner:" + std::to_string(owner),
+          "label=" + std::to_string(label)};
+}
+
+inline record block_propagation(unsigned long long id,
+                                unsigned long long block) {
+  return {block_propagation_stage, id, "block",
+          "block=" + std::to_string(block)};
+}
+
+inline record final_partition(unsigned long long id,
+                              unsigned long long block) {
+  return {final_partition_stage, id, "partition",
+          "block=" + std::to_string(block)};
+}
+
+inline std::vector<record>& records() {
+  static std::vector<record> values;
+  return values;
+}
+
+inline void append(record value) {
+  if (std::getenv("KAHIP_MPI_TRACE_PATH") != NULL) {
+    records().push_back(value);
+  }
+}
+
+inline std::string canonical_text() {
+  std::vector<record> values = records();
+  std::sort(values.begin(), values.end(),
+            [](const record& lhs, const record& rhs) {
+              return std::tie(lhs.stage_id, lhs.global_id, lhs.semantic_key,
+                              lhs.payload) <
+                     std::tie(rhs.stage_id, rhs.global_id, rhs.semantic_key,
+                              rhs.payload);
+            });
+  std::string output =
+      "kahip-mpi-trace-v1 upstream="
+      "5935f349f65f1788a9b68fcf6d853e698d86956d\n";
+  for (std::vector<record>::const_iterator value = values.begin();
+       value != values.end(); ++value) {
+    output += std::string(stage_name(value->stage_id)) +
+              " global=" + std::to_string(value->global_id) +
+              " key=" + value->semantic_key;
+    if (!value->payload.empty()) {
+      output += " " + value->payload;
+    }
+    output += "\n";
+  }
+  return output;
+}
+
+inline void write_rank_file_if_requested(MPI_Comm communicator) {
+  const char* base = std::getenv("KAHIP_MPI_TRACE_PATH");
+  if (base == NULL) return;
+  int rank = 0;
+  if (MPI_Comm_rank(communicator, &rank) != MPI_SUCCESS) {
+    throw std::runtime_error("oracle trace rank query failed");
+  }
+  const std::string path =
+      std::string(base) + ".rank" + std::to_string(rank) + ".trace";
+  std::ofstream output(path.c_str(), std::ios::binary | std::ios::trunc);
+  if (!output) throw std::runtime_error("oracle trace open failed");
+  output << canonical_text();
+  if (!output) throw std::runtime_error("oracle trace write failed");
+}
+}  // namespace kahip_task5_oracle_trace
+
+#define KAHIP_TASK5_ORACLE_TRACE(expression) \
+  do { kahip_task5_oracle_trace::append((expression)); } while (false)
+
+#endif
